<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_4"
        android:paddingBottom="@dimen/space_5">

        <!-- 标题 + 状态胶囊 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_idle"
                android:text="@string/status_ready"
                android:textColor="@color/success"
                android:textSize="@dimen/text_micro" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:text="@string/tagline"
            style="@style/LongShotLabel" />

        <!-- 运行条件 -->
        <LinearLayout
            style="@style/LongShotCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_3"
            android:paddingVertical="@dimen/space_1">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/perm_title"
                style="@style/LongShotCardTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="@dimen/space_2">

                <View
                    android:id="@+id/dotAcc"
                    android:layout_width="@dimen/dot_size"
                    android:layout_height="@dimen/dot_size"
                    android:background="@drawable/dot_bad" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_3"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_acc_title"
                        style="@style/LongShotRowTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_acc_sub"
                        style="@style/LongShotRowSub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnEnableAccessibility"
                    style="@style/LongShotPermAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_go" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="@dimen/space_2">

                <View
                    android:id="@+id/dotOv"
                    android:layout_width="@dimen/dot_size"
                    android:layout_height="@dimen/dot_size"
                    android:background="@drawable/dot_bad" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_3"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_overlay_title"
                        style="@style/LongShotRowTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_overlay_sub"
                        style="@style/LongShotRowSub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnEnableOverlay"
                    style="@style/LongShotPermAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_go" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="@dimen/space_2">

                <View
                    android:id="@+id/dotNt"
                    android:layout_width="@dimen/dot_size"
                    android:layout_height="@dimen/dot_size"
                    android:background="@drawable/dot_bad" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_3"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_notif_title"
                        style="@style/LongShotRowTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_notif_sub"
                        style="@style/LongShotRowSub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnEnableNotification"
                    style="@style/LongShotPermAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_go" />
            </LinearLayout>
        </LinearLayout>

        <!-- 截屏设置 -->
        <LinearLayout
            style="@style/LongShotCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:orientation="vertical"
            android:padding="@dimen/space_3">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                style="@style/LongShotCardTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/settings_slide_ratio"
                style="@style/LongShotLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.slider.Slider
                    android:id="@+id/sRatio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="10"
                    android:valueTo="85"
                    android:stepSize="1"
                    android:value="60" />

                <TextView
                    android:id="@+id/tvRatioVal"
                    style="@style/LongShotValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="60%" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/settings_interval"
                style="@style/LongShotLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.slider.Slider
                    android:id="@+id/sInterval"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="600"
                    android:valueTo="2000"
                    android:stepSize="100"
                    android:value="900" />

                <TextView
                    android:id="@+id/tvIntVal"
                    style="@style/LongShotValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="900ms" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/settings_scale"
                style="@style/LongShotLabel" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/scaleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScale100"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="1.0×"
                    android:textSize="@dimen/text_label" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScale075"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="0.75×"
                    android:textSize="@dimen/text_label" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScale050"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="0.5×"
                    android:textSize="@dimen/text_label" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/tvMeta"
                style="@style/LongShotMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2" />
        </LinearLayout>

        <!-- 主操作 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_primary_height"
            android:layout_marginTop="@dimen/space_4"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/btn_start"
            android:textColor="@color/on_primary"
            android:textSize="@dimen/text_button"
            app:backgroundTint="@color/primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_secondary_height"
            android:layout_marginTop="@dimen/space_2"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/btn_stop"
            android:textSize="@dimen/text_body" />

        <!-- 快捷入口 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViaProjection"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_2"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_via_projection"
                android:textSize="@dimen/text_caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeepAlive"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_2"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_keep_alive"
                android:textSize="@dimen/text_caption"
                app:strokeColor="@color/error" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvKeepAliveSteps"
            android:visibility="gone"
            style="@style/LongShotCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:padding="@dimen/space_2"
            android:lineSpacingExtra="@dimen/space_1"
            android:text="@string/keep_alive_hint"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_secondary" />

        <!-- 使用步骤 -->
        <LinearLayout
            style="@style/LongShotCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:orientation="vertical"
            android:padding="@dimen/space_3">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/usage_title"
                style="@style/LongShotCardTitle" />

            <TextView
                style="@style/LongShotStepText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/usage_step1" />

            <TextView
                style="@style/LongShotStepText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/usage_step2" />

            <TextView
                style="@style/LongShotStepText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/usage_step3" />

            <TextView
                style="@style/LongShotStepText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/usage_step4" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/usage_note"
                style="@style/LongShotNote" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
